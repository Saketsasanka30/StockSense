// StockSense Production PostgreSQL Database Schema (Prisma ORM)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  OWNER
  ADMIN
  MANAGER
  WAREHOUSE_STAFF
  VIEWER
}

enum StockStatus {
  HEALTHY
  LOW_STOCK
  CRITICAL
  OUT_OF_STOCK
  OVERSTOCK
  EXPIRING_SOON
  DEAD_STOCK
  INACTIVE
}

enum MovementType {
  PURCHASE_RECEIVE
  SALES_FULFILLMENT
  SALES_RETURN
  INTER_HUB_TRANSFER
  MANUAL_ADJUSTMENT
  DAMAGE_SCRAP
  EXPIRY_DISPOSAL
  PHYSICAL_COUNT_CORRECTION
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  RESERVED
  PICKED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Business {
  id              String         @id @default(uuid())
  name            String
  type            String         // Retail, Restaurant, Warehouse, Hospital, College, Manufacturing, Other
  gstin           String?
  currency        String         @default("INR")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  users           User[]
  warehouses      Warehouse[]
  products        Product[]
  categories      Category[]
  suppliers       Supplier[]
  customers       Customer[]
  salesOrders     SalesOrder[]
  purchaseOrders  PurchaseOrder[]
  transfers       Transfer[]
  recommendations Recommendation[]
  alerts          Alert[]
  auditLogs       AuditLog[]
}

model User {
  id           String        @id @default(uuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email        String        @unique
  passwordHash String
  fullName     String
  role         RoleType      @default(MANAGER)
  avatarUrl    String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    AuditLog[]
  createdOrders SalesOrder[]
}

model Warehouse {
  id             String           @id @default(uuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code           String           // e.g. BLR-IND-01
  name           String           // e.g. Bengaluru Store A (Indiranagar)
  city           String           @default("Bengaluru")
  state          String           @default("Karnataka")
  address        String
  managerName    String
  capacityPallets Int             @default(1400)
  usedPallets    Int              @default(1240)
  bins           Bin[]
  inventory      Inventory[]
  transfersFrom  Transfer[]       @relation("OriginWarehouse")
  transfersTo    Transfer[]       @relation("DestinationWarehouse")
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Bin {
  id          String      @id @default(uuid())
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zone        String      // A01
  aisle       String      // R03
  rack        String      // S02
  shelf       String      // B14
  code        String      // BLR-A01-R03-S02-B14
  inventory   Inventory[]
}

model Category {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  products    Product[]
}

model Product {
  id              String            @id @default(uuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  sku             String            @unique
  barcode         String?           @unique
  name            String
  description     String?
  unit            String            @default("unit")
  costPrice       Decimal           @db.Decimal(12, 2)
  sellingPrice    Decimal           @db.Decimal(12, 2)
  reorderPoint    Int               @default(50)
  safetyStock     Int               @default(20)
  dailyDemandRate Float             @default(12.0)
  leadTimeDays    Int               @default(5)
  trackBatch      Boolean           @default(false)
  trackSerial     Boolean           @default(false)
  trackExpiry     Boolean           @default(false)
  inventory       Inventory[]
  movements       InventoryMovement[]
  batches         Batch[]
  serials         SerialNumber[]
  orderItems      SalesOrderItem[]
  poItems         PurchaseOrderItem[]
  transferItems   TransferItem[]
  forecasts       Forecast[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Inventory {
  id          String      @id @default(uuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  binId       String?
  bin         Bin?        @relation(fields: [binId], references: [id])
  quantity    Int         @default(0)
  reserved    Int         @default(0)
  available   Int         @default(0)
  status      StockStatus @default(HEALTHY)
  lastAuditAt DateTime?
  updatedAt   DateTime    @updatedAt

  @@unique([productId, warehouseId])
}

model InventoryMovement {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  type        MovementType
  prevQty     Int
  deltaQty    Int
  newQty      Int
  reference   String       // e.g. PO-1048, SO-8491, TR-3941
  reason      String
  userId      String?
  timestamp   DateTime     @default(now())
}

model Batch {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  batchNumber String    @unique
  quantity    Int
  mfgDate     DateTime
  expiryDate  DateTime
  warehouseId String
  createdAt   DateTime  @default(now())
}

model SerialNumber {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  serial      String    @unique
  status      String    @default("IN_STOCK") // IN_STOCK, ALLOCATED, SOLD, DEFECTIVE
  warrantyEnd DateTime?
  createdAt   DateTime  @default(now())
}

model Supplier {
  id              String          @id @default(uuid())
  businessId      String
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  code            String          @unique
  email           String
  phone           String
  address         String
  leadTimeDays    Int             @default(3)
  onTimeRate      Float           @default(98.5)
  defectRate      Float           @default(0.4)
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Customer {
  id          String        @id @default(uuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  company     String?
  email       String
  phone       String
  address     String
  creditLimit Decimal       @default(100000.0) @db.Decimal(12, 2)
  salesOrders SalesOrder[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SalesOrder {
  id          String           @id @default(uuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orderNumber String           @unique // e.g. SO-8491
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  status      OrderStatus      @default(CONFIRMED)
  totalAmount Decimal          @db.Decimal(12, 2)
  items       SalesOrderItem[]
  invoice     Invoice?
  shipment    Shipment?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  total        Decimal    @db.Decimal(12, 2)
}

model Invoice {
  id          String     @id @default(uuid())
  invoiceNum  String     @unique // e.g. INV-2026-0042
  orderId     String     @unique
  order       SalesOrder @relation(fields: [orderId], references: [id])
  subtotal    Decimal    @db.Decimal(12, 2)
  taxAmount   Decimal    @db.Decimal(12, 2)
  grandTotal  Decimal    @db.Decimal(12, 2)
  isPaid      Boolean    @default(false)
  dueDate     DateTime
  createdAt   DateTime   @default(now())
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  poNumber     String              @unique // e.g. PO-1048
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId  String
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  status       POStatus            @default(CONFIRMED)
  totalAmount  Decimal             @db.Decimal(12, 2)
  items        PurchaseOrderItem[]
  expectedDate DateTime
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  totalCost       Decimal       @db.Decimal(12, 2)
}

model Transfer {
  id             String         @id @default(uuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transferNumber String         @unique // e.g. TR-3941
  fromHubId      String
  fromHub        Warehouse      @relation("OriginWarehouse", fields: [fromHubId], references: [id])
  toHubId        String
  toHub          Warehouse      @relation("DestinationWarehouse", fields: [toHubId], references: [id])
  status         TransferStatus @default(IN_TRANSIT)
  etaHours       Float          @default(4.0)
  costSaved      Decimal        @default(3200.0) @db.Decimal(10, 2)
  items          TransferItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model TransferItem {
  id         String   @id @default(uuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
}

model Shipment {
  id             String     @id @default(uuid())
  orderId        String     @unique
  order          SalesOrder @relation(fields: [orderId], references: [id])
  trackingNumber String     @unique
  carrier        String     // BlueDart, Delhivery, DTDC
  status         String     @default("IN_TRANSIT")
  etaDate        DateTime
  createdAt      DateTime   @default(now())
}

model Forecast {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  forecastDays Int      @default(30)
  predictedQty Int
  upperBound   Int
  lowerBound   Int
  confidence   Float    @default(0.94)
  modelName    String   @default("LinearRegression+SeasonalDecomposition")
  createdAt    DateTime @default(now())
}

model Recommendation {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type          String   // STOCKOUT, OVERSTOCK, DEAD_STOCK, IMBALANCE, EXPIRY
  title         String
  problem       String
  evidence      String
  impact        String
  recommendedAction String
  confidence    Float    @default(0.95)
  actionPayload Json?
  isResolved    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Alert {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  priority    String   // CRITICAL, WARNING, INFO
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // CREATE, UPDATE, DELETE, ADJUST, TRANSFER
  entity     String   // Product, SalesOrder, Inventory, etc.
  details    Json?
  timestamp  DateTime @default(now())
}
